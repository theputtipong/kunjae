{
  "name": "@kunjae/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Zero-knowledge sync server on Cloudflare Workers",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typegen": "wrangler types",
    "typecheck": "wrangler types >/dev/null && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply kunjae --local",
    "db:migrate:remote": "wrangler d1 migrations apply kunjae --remote",
    "clean": "rm -rf .turbo .wrangler node_modules *.tsbuildinfo"
  },
  "dependencies": {
    "@kunjae/contracts": "workspace:*",
    "@kunjae/core-crypto": "workspace:*",
    "@sentry/cloudflare": "10.75.3",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "wrangler": "4.135.0"
  }
}
