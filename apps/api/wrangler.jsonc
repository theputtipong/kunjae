{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "kunjae-api",
  "main": "src/index.ts",

  "compatibility_date": "2026-09-19",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kunjae",
      "database_id": "208de587-7551-4652-b66d-25b0542aed5b",
      "migrations_dir": "migrations"
    }
  ],

  "observability": {
    "enabled": true
  },

  "triggers": {
    "crons": ["0 3 * * *"]
  }

}
