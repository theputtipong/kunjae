{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "kunjae-api",
  "main": "src/index.ts",

  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_als"],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kunjae",
      "database_id": "208de587-7551-4652-b66d-25b0542aed5b",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "CONTACT_FROM": "Kunjae <onboarding@resend.dev>",
    "CONTACT_TO": "support.pdouvch@gmail.com"
  },
  "ratelimits": [
    { "name": "PUBLIC_LIMITER", "namespace_id": "7101", "simple": { "limit": 12, "period": 60 } },
    { "name": "SYNC_LIMITER", "namespace_id": "7102", "simple": { "limit": 30, "period": 60 } },
    { "name": "SENSITIVE_LIMITER", "namespace_id": "7103", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": {
    "enabled": true
  },

  "triggers": {
    "crons": ["0 3 * * *"]
  }

}
