{
  "name": "@kunjae/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kunjae browser extension — keys live in the service worker, not in web pages",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "prepare:types": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "clean": "rm -rf .turbo .wxt .output node_modules *.tsbuildinfo"
  },
  "dependencies": {
    "@kunjae/client-core": "workspace:*",
    "@kunjae/contracts": "workspace:*",
    "@kunjae/core-crypto": "workspace:*",
    "@kunjae/domain": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "tailwindcss": "4.3.3",
    "wxt": "0.21.4"
  }
}
