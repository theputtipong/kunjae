#!/bin/sh
MSG_FILE="$1"
SUBJECT=$(grep -v '^#' "$MSG_FILE" | head -n 1)

fail() {
  printf '\033[0;31m✖ commit-msg: %s\033[0m\n' "$1" >&2
  exit 1
}

case "$SUBJECT" in
  Merge\ *|Revert\ *) ;;
  *)
    printf '%s\n' "$SUBJECT" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+' \
      || fail "หัวข้อต้องเป็นรูปแบบ conventional commits เช่น \"feat(android): …\""
    ;;
esac

if grep -v '^#' "$MSG_FILE" | grep -Eiq 'co-authored-by|generated with|claude|anthropic|chatgpt|openai|copilot|codex|🤖'; then
  fail "ข้อความ commit มีการอ้างถึงผู้ช่วย AI หรือ Co-Authored-By"
fi

exit 0
