{
  "$schema": "https://turbo.build/schema.json",

  "ui": "stream",

  "globalDependencies": ["tsconfig.base.json", ".npmrc"],

  "globalEnv": ["NODE_ENV"],

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "package.json", "tsconfig*.json"],
      "outputs": ["dist/**", "build/**", ".output/**", ".wxt/**"]
    },

    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "package.json",
        "tsconfig*.json",

        // ชนิดข้อมูลของ Workers ที่ wrangler สร้างให้ ถ้าไฟล์นี้เปลี่ยน
        // ผลการตรวจชนิดของ apps/api ย่อมเปลี่ยนตาม จึงต้องล้าง cache ด้วย
        "worker-configuration.d.ts"
      ],
      "outputs": []
    },

    "lint": {
      "inputs": ["src/**", "package.json", "eslint.config.*"],
      "outputs": []
    },

    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },

    "clean": {
      "cache": false
    }
  }
}
