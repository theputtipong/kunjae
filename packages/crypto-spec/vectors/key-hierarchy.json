{
  "description": "การคำนวณกุญแจทั้งสายจาก Master Password กับ Secret Key จนถึง Auth Key และ Wrapping Key",
  "procedure": [
    "kPassword = Argon2id(utf8(masterPassword), accountSalt, params)",
    "kSecret   = HKDF-SHA256(ikm=secretKey, salt=accountSalt, info=\"kunjae.v1.secret-key-stretch\", len=32)",
    "MUK       = HKDF-SHA256(ikm=kPassword||kSecret, salt=accountSalt, info=\"kunjae.v1.master-unlock-key\", len=32)",
    "authKey   = HKDF-SHA256(ikm=MUK, salt=accountSalt, info=\"kunjae.v1.authentication\", len=32)",
    "wrapKey   = HKDF-SHA256(ikm=MUK, salt=accountSalt, info=\"kunjae.v1.vault-key-wrapping\", len=32)"
  ],
  "input": {
    "masterPassword": "MyStr0ng!Pass รหัสไทย",
