{
  "name": "@kunjae/core-crypto",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pure, runtime-agnostic cryptographic core for Kunjae. No I/O, no globals, no side effects.",
  "license": "MIT",

  "sideEffects": false,

  "exports": {
    ".": "./src/index.ts",
    "./primitives": "./src/primitives/index.ts"
  },

  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo node_modules *.tsbuildinfo"
  },

  "dependencies": {
    "@noble/hashes": "2.4.0",
    "hash-wasm": "4.12.0"
  }
}
